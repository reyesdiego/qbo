DATABASE_URL=postgres://postgres:postgres@localhost:5433/invoices
PORT=3000

# From your app's Keys & credentials page on https://developer.intuit.com
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
# Must match a Redirect URI configured in the Intuit app
QBO_REDIRECT_URI=http://localhost:3000/callback/

# Sync worker
# Seconds between polls for queued jobs (the fallback: NOTIFY wakes the worker right away)
SYNC_POLL_INTERVAL_SECONDS=5
# Seconds between reconciliations (QuickBooks changes webhooks missed, UNKNOWN creates)
SYNC_RECONCILE_INTERVAL_SECONDS=300
# How long a worker owns a claimed job before another worker may take it over
SYNC_JOB_LEASE_SECONDS=300
# Attempts before a job is FAILED, and the base delay of the exponential backoff
SYNC_MAX_ATTEMPTS=8
SYNC_RETRY_BASE_SECONDS=10
# Hours between full consistency checks with QuickBooks (repairs rows deleted by hand, missed changes)
SYNC_CONSISTENCY_INTERVAL_HOURS=24
# How long to wait before searching QuickBooks for a create whose result is UNKNOWN
SYNC_UNKNOWN_GRACE_SECONDS=120
# Minimum milliseconds between QuickBooks requests per process (limit: 500 per minute per company)
QBO_MIN_REQUEST_INTERVAL_MS=150

# From the app's Webhooks page on https://developer.intuit.com (used to verify notifications)
QBO_WEBHOOK_VERIFIER_TOKEN=
